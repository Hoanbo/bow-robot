{
    "name": "bow-robot",
    "version": "4.0.0",
    "description": "BOW ROBOT V4.0 — The Fully Autonomous Embodied Companion (Connected to @bow/agent v4.0.0)",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=18.0.0"
    },
    "workspaces": [
        "bow-server",
        "bow-remote-agent",
        "shared",
        "simulator",
        "tests"
    ],
    "scripts": {
        "prepare": "husky install || echo skip",
        "dev": "npm run dev --workspaces",
        "build": "npm run build --workspace=@bow/shared && npm run build --workspace=@bow/server && npm run build --workspace=@bow/remote-agent && npm run build --workspace=@bow/simulator && npm run build --workspace=@bow/tests",
        "test": "npm run build && npm test --workspace=@bow/tests",
        "clean": "npm run clean --workspaces && rm -rf node_modules",
        "lint": "eslint . --ext .ts",
        "format": "prettier --write \"**/*.ts\"",
        "server": "npm run dev --workspace=bow-server",
        "agent": "npm run dev --workspace=bow-remote-agent",
        "simulator": "npm run dev --workspace=simulator",
        "validate:local": "node scripts/validate-local.mjs",
        "network:diagnose": "node scripts/network-diagnose.mjs",
        "e2e:lan": "node scripts/run-lan-e2e.mjs",
        "e2e:windows": "node scripts/run-windows-e2e.mjs"
    },
    "dependencies": {
        "@bow/agent": "^4.0.0"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^6.7.2",
        "@typescript-eslint/parser": "^6.7.2",
        "eslint": "^8.49.0",
        "prettier": "^3.0.3",
        "typescript": "^5.2.2"
    }
}
