# BOW ROBOT V1.0 CONFIGURATION

# Environment
NODE_ENV=development
LOG_LEVEL=info

# BOW SERVER (Xeon PC)
BOW_SERVER_HOST=0.0.0.0
BOW_SERVER_PORT=3000
BOW_SERVER_VERSION=1.0.0

# REMOTE AGENT (User's PC)
# On PC B, BOW_SERVER_HOST must be the LAN IPv4 address of PC A (Xeon).
# The agent makes an outbound connection; it does not expose REMOTE_AGENT_PORT.
REMOTE_AGENT_HOST=unused
REMOTE_AGENT_PORT=3001
REMOTE_AGENT_TOKEN=change-me-to-a-secure-token

# BOW AGENT BRAIN GATEWAY (V3.3 Central Intelligence on Port 4000)
BOW_AGENT_WS_URL=ws://127.0.0.1:4000
BOW_AGENT_PORT=4000
BOW_AGENT_HOST=0.0.0.0

# AI PROVIDER
AI_PROVIDER=openai
AI_API_KEY=sk-...
AI_MODEL=gpt-4
AI_MAX_TOKENS=8192

# VISION PROVIDER
VISION_PROVIDER=openai
VISION_API_KEY=sk-...
VISION_MODEL=gpt-4-vision-preview

# SPEECH PROVIDERS (Vietnamese Natural Voice Engine)
# TTS: "edge-tts" (Free, high-fidelity neural Vietnamese voice) or "openai"
TTS_PROVIDER=edge-tts
TTS_VOICE=vi-VN-HoaiMyNeural
# Alternative voice: vi-VN-NamMinhNeural
TTS_MODEL=vi-VN-HoaiMyNeural
TTS_API_KEY=

# STT: "whisper" or "faster-whisper" or "openai"
STT_PROVIDER=whisper
STT_MODEL=whisper-1
STT_API_KEY=
STT_BASE_URL=

# HEADSET VOICE (remote agent PC; requires ffmpeg + ffplay on Windows)
BOW_VOICE_ENABLED=false
BOW_VOICE_LISTEN_MS=5000
BOW_AUDIO_INPUT_DEVICE=
BOW_AUDIO_OUTPUT_DEVICE=
# On Windows, input/output names are the ffmpeg/ffplay device names. Leave empty to use OS default output.
# Optional command templates if the OS defaults/tools differ. Use {output}, {input}, {duration}.
# BOW_AUDIO_CAPTURE_COMMAND=
# BOW_AUDIO_PLAYBACK_COMMAND=

# ROBOT GATEWAY
ROBOT_ENABLED=true
ROBOT_MODE=simulator
ROBOT_SERIAL_PORT=/dev/ttyUSB0
ROBOT_BAUD_RATE=115200

# MEMORY
MEMORY_TYPE=sqlite
MEMORY_DB_PATH=./data/memory.db
MEMORY_MAX_SIZE=10000

# SAFETY
SAFETY_ENABLED=true
SAFETY_REQUIRE_CONFIRMATION=true
SAFETY_DANGEROUS_COMMANDS_BLOCKED=true

# LOGGING
LOG_FILE_PATH=./logs/bow.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# TESTING
BOW_TEST_ENABLED=true
BOW_TEST_TIMEOUT=30000
BOW_TEST_COMMAND=

# Deployment mode
REMOTE_AGENT_ENABLED=true
VISION_ENABLED=false
STT_ENABLED=false
TTS_ENABLED=false

# NETWORK SECURITY
SERVER_REQUIRE_AUTH=true
SERVER_ALLOW_LOCALHOST_ONLY=true
MAX_CONNECTIONS=10
CONNECTION_TIMEOUT=30000
HEARTBEAT_INTERVAL=5000

# DEVELOPMENT
DEBUG=bow:*
ENABLE_PLAYGROUND=true
ENABLE_METRICS=true
