{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@bow/shared": [
        "./shared/dist",
        "./shared/src"
      ],
      "@bow/shared/*": [
        "./shared/dist/*",
        "./shared/src/*"
      ],
      "@bow/server": [
        "./bow-server/dist",
        "./bow-server/src"
      ],
      "@bow/server/*": [
        "./bow-server/dist/*",
        "./bow-server/src/*"
      ],
      "@bow/remote-agent": [
        "./bow-remote-agent/dist",
        "./bow-remote-agent/src"
      ],
      "@bow/remote-agent/*": [
        "./bow-remote-agent/dist/*",
        "./bow-remote-agent/src/*"
      ],
      "@bow/simulator": [
        "./simulator/dist",
        "./simulator/src"
      ],
      "@bow/simulator/*": [
        "./simulator/dist/*",
        "./simulator/src/*"
      ]
    }
  },
  "include": [
    "bow-server/src/**/*",
    "bow-remote-agent/src/**/*",
    "shared/src/**/*",
    "simulator/src/**/*",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/build"
  ]
}