{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": ".",
        "paths": {
            "@bow/shared": [
                "../shared/dist",
                "../shared/src"
            ],
            "@bow/server": [
                "../bow-server/dist",
                "../bow-server/src"
            ],
            "@bow/server/*": [
                "../bow-server/dist/*",
                "../bow-server/src/*"
            ],
            "@bow/remote-agent": [
                "../bow-remote-agent/dist",
                "../bow-remote-agent/src"
            ],
            "@bow/remote-agent/*": [
                "../bow-remote-agent/dist/*",
                "../bow-remote-agent/src/*"
            ],
            "@bow/simulator": [
                "../simulator/dist",
                "../simulator/src"
            ],
            "@bow/simulator/*": [
                "../simulator/dist/*",
                "../simulator/src/*"
            ]
        }
    },
    "include": [
        "./**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
